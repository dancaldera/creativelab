{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creative Studio",
  "version": "0.1.0",
  "identifier": "com.creativelab.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "pnpm --filter @creativelab/desktop run dev",
    "beforeBuildCommand": "pnpm --filter @creativelab/desktop run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Creative Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Video",
    "shortDescription": "Local-first AI creative studio",
    "longDescription": "Non-destructive video, image, audio and voice generation with entirely local project ownership.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": []
  },
  "plugins": {}
}
